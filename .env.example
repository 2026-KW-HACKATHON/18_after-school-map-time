# 이 파일을 복사해서 .env 를 만드세요:  cp .env.example .env
# .env 는 절대 커밋하지 않습니다. 새 변수를 추가하면 여기(빈 값)와 README 환경 변수 표를 같이 갱신하세요.

# ── Django ──
# SECRET_KEY 생성 (Django 설치 없이 가능): python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# (배포) https 포함 도메인, 콤마 구분. 예: https://teokeopne.example.com
CSRF_TRUSTED_ORIGINS=

# ── Database ──
# docker compose의 Postgres 컨테이너 초기값. 개발은 단순값, 배포는 반드시 강한 비밀번호로.
POSTGRES_DB=teokeopne
POSTGRES_USER=teokeopne
POSTGRES_PASSWORD=teokeopne
# 비워두면 SQLite로 폴백 (docker 없이 로컬 실행할 때)
DATABASE_URL=postgres://teokeopne:teokeopne@db:5432/teokeopne

# ── 카카오맵 ──
# 카카오 개발자센터 > 내 애플리케이션 > 앱 키
# JavaScript 키: 브라우저에 노출됨 → 플랫폼 > Web 에 허용 도메인(localhost:8000, 배포 도메인)만 등록
KAKAO_JAVASCRIPT_KEY=
# REST API 키: 서버에서만 사용 (주소→좌표 변환 등). 템플릿/JS로 절대 내보내지 않기
KAKAO_REST_API_KEY=
# 카카오 로그인 Client Secret (카카오 로그인 > 보안에서 '사용함'일 때만 입력, 아니면 빈 값)
# Redirect URI 등록: http://localhost:8000/accounts/kakao/login/callback/ , https://<도메인>/accounts/kakao/login/callback/
KAKAO_CLIENT_SECRET=

# ── 운영자 AI 검토 보조 (OpenAI, 서버 전용) ──
# 팀 결정(모델·예산)과 제보 화면 개인정보 고지 검토가 끝나기 전에는 False 유지
OPENAI_API_KEY=
AI_ENABLED=False
# 이미지 입력 + Structured Outputs를 지원하고 이 계정에서 쓸 수 있는 모델 ID
OPENAI_MODEL=
# 서울 시간 하루 동안 전체 운영자가 OpenAI를 부를 수 있는 최대 횟수 (0이면 호출 안 함)
AI_DAILY_LIMIT=100
# 제보 화면에 AI 안내를 붙인 시각 (시간대 포함, 예: 2026-10-07T00:00:00+09:00). 이전 제보는 보내지 않음
AI_NOTICE_SINCE=
# 제보 화면 AI 안내 문구의 버전 (예: ai-notice-v1). 문구를 바꾸면 AI_NOTICE_SINCE와 함께 올림
AI_NOTICE_VERSION=

# ── 공공데이터 (선택) ──
# 공공데이터포털 '한국사회보장정보원_장애인편의시설 현황' 활용신청 → 마이페이지의 "일반 인증키"
# python manage.py import_public_facilities 에서만 사용 (서버 전용)
PUBLIC_DATA_API_KEY=

# ── 배포 (docker-compose.prod.yml, 서버의 .env에서만 채움) ──
# 배포 도메인 (예: teokeopne.duckdns.org). nginx HTTPS 설정의 server_name·인증서 경로에 쓰임
DOMAIN=
# nginx 설정 선택: http(인증서 발급 전·로컬 검증) → 인증서 발급 후 https 로 변경
NGINX_CONF=http
# 배포할 이미지 태그: 평소 latest, 롤백할 때만 이전 커밋 SHA로 변경
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────
# HTTPS 설정 (.env 의 NGINX_CONF=https)
#   인증서를 발급받은 뒤에만 사용 (인증서 파일이 없으면 nginx가 시작되지 않음)
#   ${DOMAIN} 등은 nginx 컨테이너가 시작할 때 .env 값으로 치환됨 (docker-compose.prod.yml 참고)
#
#   DOMAIN           대표 주소. 서비스는 이 주소로만 응답 (예: teokeopne.help)
#   REDIRECT_DOMAINS 대표 주소로 301 이동시킬 다른 주소들, 공백 구분 (예: www.teokeopne.help teokeopne.duckdns.org)
#                    → 로그인 쿠키·카카오 로그인 Redirect URI·QR 주소가 한 주소로 모임. 예전 주소로 인쇄된 QR도 계속 동작
#                    비어 있으면 아무 주소도 이동시키지 않음 (예전 동작 그대로)
#   CERT_NAME        인증서 폴더 이름 /etc/letsencrypt/live/<CERT_NAME>/ (비우면 DOMAIN). 인증서 하나에 위 주소가 모두 들어 있어야 함
# ─────────────────────────────────────────────────────────

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml text/plain;

# 80번: 인증서 갱신 확인 파일만 응답하고(모든 주소), 나머지는 같은 주소의 https로
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 443번: 다른 주소(www·예전 주소) → 대표 주소로 이동
server {
    listen 443 ssl;
    http2 on;
    server_name ${REDIRECT_DOMAINS};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://${DOMAIN}$request_uri;
}

# 443번: 실제 서비스 (대표 주소. 목록에 없는 주소로 들어와도 여기서 응답)
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    # certbot이 발급한 인증서 (호스트의 /etc/letsencrypt 를 읽기 전용으로 마운트)
    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;

    # 오래된 프로토콜(TLS 1.0/1.1) 차단
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/app.conf;
}
